NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=mysql://hosom:hosom_local_password@127.0.0.1:3306/hosom
# Dedicated database for integration tests; never point this at application data.
TEST_DATABASE_URL=mysql://hosom:hosom_local_password@127.0.0.1:3306/hosom_test
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Number of trusted reverse proxy hops; keep 0 for direct connections.
TRUST_PROXY_HOPS=0
