generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  LECTURER
  SECRETARIAT
  FINANCE
  ADMINISTRATION
  HEAD_OF_PROGRAMS
  HEAD_OF_HOSOM
  DIRECTOR
  MEDIA
  SYSTEM_ADMIN
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  PENDING
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  DROPPED
}

enum MaterialType {
  LESSON
  COURSE_OUTLINE
  LECTURE_NOTES
  PDF_DOCUMENT
  PRESENTATION
  VIDEO_LECTURE
  RECORDED_CLASS
  AUDIO_RESOURCE
  READING_MATERIAL
  BOOK
  ONLINE_RESOURCE
}

enum MaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionFormat {
  FILE
  TEXT
  BOTH
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  AWAITING_MARKING
  MARKED
  READY_FOR_REVIEW
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
}

model User {
  id           String    @id @default(uuid()) @db.VarChar(191)
  firstName    String    @map("first_name") @db.VarChar(100)
  middleName   String?   @map("middle_name") @db.VarChar(100)
  surname      String    @map("last_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(191)
  phone        String?   @map("phone") @db.VarChar(30)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(STUDENT)
  loggedInAt   DateTime? @map("logged_in_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student             Student?
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  taughtCourses       CourseLecturer[]
  createdMaterials    LearningMaterial[]
  createdAssignments  Assignment[]
  gradedSubmissions   AssignmentSubmission[] @relation("SubmissionGrader")

  @@index([role, isActive], map: "users_role_is_active_idx")
  @@map("users")
}

model UserSession {
  id         String    @id @default(uuid()) @db.VarChar(191)
  userId     String    @map("user_id") @db.VarChar(191)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt], map: "user_sessions_user_revoked_idx")
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(191)
  userId    String    @map("user_id") @db.VarChar(191)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt], map: "password_reset_tokens_user_used_idx")
  @@map("password_reset_tokens")
}

model Student {
  id             String        @id @default(uuid()) @db.VarChar(36)
  userId         String        @unique @db.VarChar(191)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber  String?       @unique @db.VarChar(50)
  status         StudentStatus @default(ACTIVE)
  gender         String?       @db.VarChar(20)
  dateOfBirth    DateTime?
  nationality    String?       @db.VarChar(80)
  address        String?       @db.VarChar(255)
  district       String?       @db.VarChar(100)
  guardianName   String?       @db.VarChar(100)
  guardianPhone  String?       @db.VarChar(30)
  program        String?       @db.VarChar(100)
  intake         String?       @db.VarChar(60)
  yearOfStudy    Int?
  modeOfLearning String?       @db.VarChar(40)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  enrollments Enrollment[]
  submissions AssignmentSubmission[]

  @@index([status], map: "student_status_idx")
  @@map("student")
}

model Program {
  id          String   @id @default(uuid()) @db.VarChar(191)
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(150)
  awardType   String   @map("award_type") @db.VarChar(50)
  duration    String?  @db.VarChar(50)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("programs")
}

model AcademicPeriod {
  id           String    @id @default(uuid()) @db.VarChar(191)
  name         String    @unique @db.VarChar(100)
  academicYear String    @map("academic_year") @db.VarChar(20)
  semester     String    @db.VarChar(40)
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  isCurrent    Boolean   @default(false) @map("is_current")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  courses     Course[]
  enrollments Enrollment[]

  @@map("academic_periods")
}

model Course {
  id               String          @id @default(uuid()) @db.VarChar(191)
  code             String          @unique @db.VarChar(30)
  title            String          @db.VarChar(180)
  description      String?         @db.Text
  credits          Int             @default(3)
  programId        String?         @map("program_id") @db.VarChar(191)
  program          Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  academicPeriodId String?         @map("academic_period_id") @db.VarChar(191)
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  status           CourseStatus    @default(ACTIVE)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  lecturers   CourseLecturer[]
  enrollments Enrollment[]
  units       CourseUnit[]
  materials   LearningMaterial[]
  assignments Assignment[]

  @@index([programId, status], map: "courses_program_status_idx")
  @@map("courses")
}

model CourseLecturer {
  id         String   @id @default(uuid()) @db.VarChar(191)
  courseId   String   @map("course_id") @db.VarChar(191)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturerId String   @map("lecturer_id") @db.VarChar(191)
  lecturer   User     @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(true) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([courseId, lecturerId], map: "course_lecturers_unique")
  @@map("course_lecturers")
}

model Enrollment {
  id               String           @id @default(uuid()) @db.VarChar(191)
  studentId        String           @map("student_id") @db.VarChar(36)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String           @map("course_id") @db.VarChar(191)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicPeriodId String?          @map("academic_period_id") @db.VarChar(191)
  academicPeriod   AcademicPeriod?  @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now()) @map("enrolled_at")
  completedAt      DateTime?        @map("completed_at")

  @@unique([studentId, courseId], map: "enrollments_student_course_unique")
  @@index([courseId, status], map: "enrollments_course_status_idx")
  @@map("enrollments")
}

model CourseUnit {
  id          String   @id @default(uuid()) @db.VarChar(191)
  courseId    String   @map("course_id") @db.VarChar(191)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(160)
  description String?  @db.Text
  order       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials LearningMaterial[]

  @@index([courseId, order], map: "course_units_course_order_idx")
  @@map("course_units")
}

model LearningMaterial {
  id               String         @id @default(uuid()) @db.VarChar(191)
  courseId         String         @map("course_id") @db.VarChar(191)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitId           String?        @map("unit_id") @db.VarChar(191)
  unit             CourseUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById      String         @map("created_by_id") @db.VarChar(191)
  createdBy        User           @relation(fields: [createdById], references: [id])
  title            String         @db.VarChar(200)
  description      String?        @db.Text
  body             String?        @db.LongText
  type             MaterialType   @default(LECTURE_NOTES)
  status           MaterialStatus @default(DRAFT)
  order            Int            @default(1)
  url              String?        @db.VarChar(500)
  fileName         String?        @map("file_name") @db.VarChar(255)
  mimeType         String?        @map("mime_type") @db.VarChar(120)
  fileSize         Int?           @map("file_size")
  storageKey       String?        @map("storage_key") @db.VarChar(500)
  allowDownload    Boolean        @default(true) @map("allow_download")
  approvedExternal Boolean        @default(false) @map("approved_external")
  publishedAt      DateTime?      @map("published_at")
  expiresAt        DateTime?      @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([courseId, status], map: "learning_materials_course_status_idx")
  @@index([unitId], map: "learning_materials_unit_idx")
  @@map("learning_materials")
}

model Assignment {
  id               String           @id @default(uuid()) @db.VarChar(191)
  courseId         String           @map("course_id") @db.VarChar(191)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById      String           @map("created_by_id") @db.VarChar(191)
  createdBy        User             @relation(fields: [createdById], references: [id])
  title            String           @db.VarChar(200)
  instructions     String           @db.LongText
  totalMarks       Int              @default(100) @map("total_marks")
  submissionFormat SubmissionFormat @default(BOTH) @map("submission_format")
  attachmentName   String?          @map("attachment_name") @db.VarChar(255)
  attachmentUrl    String?          @map("attachment_url") @db.VarChar(500)
  deadline         DateTime
  allowLate        Boolean          @default(false) @map("allow_late")
  status           AssignmentStatus @default(DRAFT)
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  submissions AssignmentSubmission[]

  @@index([courseId, status], map: "assignments_course_status_idx")
  @@map("assignments")
}

model AssignmentSubmission {
  id                 String           @id @default(uuid()) @db.VarChar(191)
  assignmentId       String           @map("assignment_id") @db.VarChar(191)
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String           @map("student_id") @db.VarChar(36)
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answerText         String?          @map("answer_text") @db.LongText
  attachmentName     String?          @map("attachment_name") @db.VarChar(255)
  attachmentUrl      String?          @map("attachment_url") @db.VarChar(500)
  attachmentMimeType String?          @map("attachment_mime_type") @db.VarChar(120)
  attachmentSize     Int?             @map("attachment_size")
  status             SubmissionStatus @default(SUBMITTED)
  mark               Float?
  feedback           String?          @db.Text
  gradedById         String?          @map("graded_by_id") @db.VarChar(191)
  gradedBy           User?            @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt           DateTime?        @map("graded_at")
  submittedAt        DateTime         @default(now()) @map("submitted_at")
  isLate             Boolean          @default(false) @map("is_late")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([assignmentId, studentId], map: "assignment_submissions_unique")
  @@index([studentId, status], map: "assignment_submissions_student_status_idx")
  @@map("assignment_submissions")
}
